{
  "expo": {
    "name": "schoolkompass",
    "slug": "schoolkompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "schoolkompass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "permissions": [
      "audioRecording"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itwela.schoolkompass",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow School Kompass to use the camera to capture study documents.",
          "photosPermission": "Allow School Kompass to access photos to import study documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "REPLICATE_API_TOKEN_1": "r8_ai4ppQD2FogRc23tuz",
      "REPLICATE_API_TOKEN_2": "aTRw7dptK68VW4gY3lK",
      "OPENROUTER_API_KEY_1": "sk-or-v1-41e17c2c1e543bed5566c5e86d40f4a614",
      "OPENROUTER_API_KEY_2": "5158253939ae86143a7c8266a2bc9d",
      "eas": {
        "projectId": "92a0f2b7-71e4-44db-8c37-87d956476858"
      }
    }
  }
}
